    <body>
      <trans-unit id="tl_status_update.title_legend">
        <source>Title and description</source>
        <target>Titel und Beschreibung</target>
      </trans-unit>
      <trans-unit id="tl_status_update.date_legend">
        <source>Date and visibility</source>
        <target>Datum und Sichtbarkeit</target>
      </trans-unit>
      <trans-unit id="tl_status_update.publish_legend">
        <source>Publish settings</source>
        <target>Veröffentlichung</target>
      </trans-unit>

      <trans-unit id="tl_status_update.title.0">
        <source>Title</source>
        <target>Titel</target>
      </trans-unit>
      <trans-unit id="tl_status_update.title.1">
        <source>Please enter the title of the status update.</source>
        <target>Bitte geben Sie den Titel des Status-Updates ein.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.description.0">
        <source>Description</source>
        <target>Beschreibung</target>
      </trans-unit>
      <trans-unit id="tl_status_update.description.1">
        <source>Enter a detailed description for this status update.</source>
        <target>Geben Sie eine detaillierte Beschreibung für dieses Status-Update ein.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.date.0">
        <source>Date</source>
        <target>Datum</target>
      </trans-unit>
      <trans-unit id="tl_status_update.date.1">
        <source>Backend: the event day this update refers to. Frontend: the day from which the message starts to appear.</source>
        <target>Backend: der Tag, auf den sich das Update bezieht. Frontend: der Tag, ab dem der Hinweis angezeigt wird.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.show_days_before.0">
        <source>Show notification before event</source>
        <target>Hinweis vorab anzeigen</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_before.1">
        <source>How many days before the event should the notification be displayed?</source>
        <target>Wie viele Tage vor dem Ereignis soll der Hinweis angezeigt werden?</target>
      </trans-unit>

      <trans-unit id="tl_status_update.show_days_after.0">
        <source>Show notification after event</source>
        <target>Hinweis danach anzeigen</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_after.1">
        <source>How many days after the event should the notification be displayed?</source>
        <target>Wie viele Tage nach dem Ereignis soll der Hinweis angezeigt werden?</target>
      </trans-unit>

      <trans-unit id="tl_status_update.published.0">
        <source>Published</source>
        <target>Veröffentlicht</target>
      </trans-unit>
      <trans-unit id="tl_status_update.published.1">
        <source>Make this status update visible in the backend.</source>
        <target>Dieses Status-Update im Backend sichtbar machen.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.completed.0">
        <source>Completed</source>
        <target>Abgeschlossen</target>
      </trans-unit>
      <trans-unit id="tl_status_update.completed.1">
        <source>Mark this status update as completed. It will be displayed in green with a checkmark icon.</source>
        <target>Dieses Status-Update als abgeschlossen markieren. Es wird grün mit einem Häkchen-Symbol angezeigt.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.toggleCompleted.0">
        <source>Toggle completed state</source>
        <target>Abschluss umschalten</target>
      </trans-unit>
      <trans-unit id="tl_status_update.toggleCompleted.1">
        <source>Toggle the completed state of status update ID %s</source>
        <target>Abschluss-Status von Status-Update ID %s umschalten</target>
      </trans-unit>

      <trans-unit id="tl_status_update.settings.0">
        <source>Settings</source>
        <target>Einstellungen</target>
      </trans-unit>
      <trans-unit id="tl_status_update.settings.1">
        <source>Edit the status update settings</source>
        <target>Einstellungen der Status-Updates bearbeiten</target>
      </trans-unit>

      <trans-unit id="tl_status_update.show_days_before_options.7_days">
        <source>7 days before</source>
        <target>7 Tage vorher</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_before_options.10_days">
        <source>10 days before</source>
        <target>10 Tage vorher</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_before_options.30_days">
        <source>30 days before</source>
        <target>30 Tage vorher</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_before_options.only_on_event_day">
        <source>Only on event day</source>
        <target>Nur am Tag des Ereignisses</target>
      </trans-unit>

      <trans-unit id="tl_status_update.show_days_after_options.only_on_event_day">
        <source>Only on event day</source>
        <target>Nur am Tag des Ereignisses</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_after_options.1_day">
        <source>1 day after</source>
        <target>1 Tag danach</target>
      </trans-unit>
      <trans-unit id="tl_status_update.show_days_after_options.7_days">
        <source>7 days after</source>
        <target>7 Tage danach</target>
      </trans-unit>

      <trans-unit id="tl_status_update.scope_legend">
        <source>Scope</source>
        <target>Wo wird angezeigt</target>
      </trans-unit>

      <trans-unit id="tl_status_update.scope.0">
        <source>Display scope</source>
        <target>Anzeigebereich</target>
      </trans-unit>
      <trans-unit id="tl_status_update.scope.1">
        <source>Where should this status update be visible?</source>
        <target>Wo soll dieses Status-Update sichtbar sein?</target>
      </trans-unit>

      <trans-unit id="tl_status_update.scope_options.backend">
        <source>Backend dashboard only</source>
        <target>Nur im Backend-Dashboard</target>
      </trans-unit>
      <trans-unit id="tl_status_update.scope_options.frontend">
        <source>Frontend only</source>
        <target>Nur im Frontend</target>
      </trans-unit>
      <trans-unit id="tl_status_update.scope_options.both">
        <source>Backend and frontend</source>
        <target>Backend und Frontend</target>
      </trans-unit>

      <trans-unit id="tl_status_update.date_end.0">
        <source>Display until</source>
        <target>Anzeigen bis</target>
      </trans-unit>
      <trans-unit id="tl_status_update.date_end.1">
        <source>Until when should the message be visible in the frontend? Leave empty for permanent display.</source>
        <target>Bis wann soll der Hinweis im Frontend angezeigt werden? Leer lassen für dauerhafte Anzeige.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.date_end_before_start">
        <source>The end date must not be before the start date.</source>
        <target>Das Enddatum darf nicht vor dem Startdatum liegen.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.type.0">
        <source>Type</source>
        <target>Typ</target>
      </trans-unit>
      <trans-unit id="tl_status_update.type.1">
        <source>Visual style of the frontend message.</source>
        <target>Visueller Stil des Frontend-Hinweises.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.type_options.neutral">
        <source>Neutral (no border)</source>
        <target>Neutral (ohne Rahmen)</target>
      </trans-unit>
      <trans-unit id="tl_status_update.type_options.info">
        <source>Info (blue)</source>
        <target>Info (blau)</target>
      </trans-unit>
      <trans-unit id="tl_status_update.type_options.success">
        <source>Success (green)</source>
        <target>Erfolg (grün)</target>
      </trans-unit>
      <trans-unit id="tl_status_update.type_options.warning">
        <source>Warning (yellow)</source>
        <target>Warnung (gelb)</target>
      </trans-unit>
      <trans-unit id="tl_status_update.type_options.critical">
        <source>Critical (red)</source>
        <target>Kritisch (rot)</target>
      </trans-unit>
      <trans-unit id="tl_status_update.type_options.promo">
        <source>Promotion (highlighted)</source>
        <target>Aktion (hervorgehoben)</target>
      </trans-unit>

      <trans-unit id="tl_status_update.dismissible.0">
        <source>Can be dismissed</source>
        <target>Kann geschlossen werden</target>
      </trans-unit>
      <trans-unit id="tl_status_update.dismissible.1">
        <source>Allow visitors to close the message. The dismissal is remembered per browser until the message is edited.</source>
        <target>Besucher:innen dürfen den Hinweis schließen. Die Auswahl bleibt pro Browser gemerkt, bis der Hinweis erneut bearbeitet wird.</target>
      </trans-unit>

      <trans-unit id="tl_status_update.frontend_pages.0">
        <source>Restrict to pages</source>
        <target>Auf Seiten einschränken</target>
      </trans-unit>
      <trans-unit id="tl_status_update.frontend_pages.1">
        <source>Show only on the selected pages and all of their subpages. Leave empty to show on all pages.</source>
        <target>Nur auf den ausgewählten Seiten und allen Unterseiten anzeigen. Leer lassen, um auf allen Seiten anzuzeigen.</target>
      </trans-unit>
    </body>
